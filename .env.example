# API
API_PORT=3000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=modaco
DB_USER=modaco
DB_PASSWORD=change_me

# Set false for production deployments that use migrations.
DB_SYNCHRONIZE=true

# RabbitMQ
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=modaco
RABBITMQ_PASSWORD=change_me
RABBITMQ_URL=amqp://modaco:change_me@rabbitmq:5672
